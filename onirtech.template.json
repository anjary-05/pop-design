{
  "schemaVersion": 1,
  "kind": "template",
  "id": "pop-design",
  "name": "Pop Design",
  "description": "Template générique : en-tête sur photo, tuiles à fenêtres, galerie et chatbot paramétrable (Markdown, suggestions, pièces jointes, secours).",
  "version": "2.6.6",
  "publisher": {
    "id": "onirtech",
    "name": "ONIRTECH",
    "trustLevel": "official"
  },
  "compatibility": {
    "hostProtocol": "onirtech.template-host.v1"
  },
  "ui": {
    "mode": "web-component",
    "entry": "./dist/index.js",
    "element": "onirtech-template-pop-design",
    "shadowDom": "open",
    "widget": {
      "entry": "./dist/widget.js",
      "element": "onirtech-widget-pop-design",
      "display": {
        "defaultPosition": "bottom-right",
        "allowedPositions": [
          "bottom-right",
          "bottom-left"
        ],
        "closedSize": {
          "width": 64,
          "height": 64
        },
        "openSize": {
          "width": 420,
          "height": 680
        },
        "maxSize": {
          "width": 520,
          "height": 760
        }
      },
      "integrity": "sha256-9DO8GLmmFv7mBvz6Wj5mhG90x6SPv2+5yEMfX4Wcml0="
    },
    "integrity": "sha256-p/tHgEW9Q9Lzb7vBIuSUFxUZpon0yRLOSIYdLlLe+XM="
  },
  "capabilities": [
    "messages",
    "media",
    "theme",
    "fallback",
    "knowledge",
    "userState"
