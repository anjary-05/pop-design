{
  "name": "pop-design",
  "version": "2.6.6",
  "private": true,
  "type": "module",
  "description": "Pop Design — template visuel Onirtech (stack React).",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "test": "vitest run",
    "build": "vite build && vite build --config vite.widget.config.ts",
    "postbuild": "node tools/widget-integrity.mjs",
    "validate": "node tools/onirtech-template.mjs validate .",
    "pack": "node tools/onirtech-template.mjs pack .",
    "check:browser": "node tools/browser-check.mjs",
    "check:backend": "node tools/backend-check.mjs",
    "icons": "node tools/extract-icons.mjs"
  },
  "dependencies": {
    "@onirtech/template-sdk": "0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.3",
    "puppeteer-core": "^25.14.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.4"
  }
}
